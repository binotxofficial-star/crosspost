# Copy this file to .env.local and fill it in.

# Random string, at least 32 characters. Encrypts saved tokens and signs cookies.
# Generate one with: openssl rand -base64 48
APP_SECRET=

# Public address of this site, without a trailing slash. Must be https:// for
# TikTok and Instagram. For local testing use a tunnel (cloudflared, ngrok).
PUBLIC_BASE_URL=https://your-domain.com

# Where uploaded videos, tokens and job records are stored.
DATA_DIR=.data

# Largest video a user can upload, in MB.
MAX_UPLOAD_MB=1024

# TikTok for Developers app (Login Kit + Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta app with "Instagram API with Instagram Login"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0

# Google Cloud OAuth client (Web application) with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
